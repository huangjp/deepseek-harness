{
  "name": "@deepseek-ai/dsh-host-local-bridge",
  "description": "In-process local model bridge: OpenAI-compatible reverse proxy over the WorkBuddy gateway or CodeBuddy CLI, plus WeFlow session summarization; shipped with the desktop installer",
  "version": "0.2.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/local-bridge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./shared": {
      "types": "./lib/types/shared.d.ts",
      "default": "./lib/types/shared.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "bridge/bridge.mjs",
    "bridge/backends.mjs",
    "bridge/weflow.mjs",
    "bridge/toolcalls.mjs",
    "bridge/toolprompt.mjs",
    "bridge/bridge.config.json",
    "bridge/copilot-bridge.mjs",
    "bridge/token-gate.mjs",
    "bridge/copilot.config.json",
    "bridge/copilot-protocol-notes.md",
    "bridge/refresh-token.ps1",
    "bridge/token-harvester.py",
    "bridge/chat_template.json",
    "bridge/preflight.mjs",
    "bridge/xiaoyi-bridge.mjs",
    "bridge/xiaoyi.config.json",
    "bridge/xiaoyi-harvest.py",
    "bridge/xiaoyi-protocol-notes.md",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-host-webserver": "workspace:*"
  }
}
